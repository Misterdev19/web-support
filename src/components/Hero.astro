---
import { Image } from 'astro:assets';
import heroBench from '../assets/foto-hero1.webp';
import Button from './Button.astro';

const log = [
	'pasta térmica seca → reemplazada',
	'prueba de temperatura 24 h → aprobada',
	'equipo listo para entregar',
];
---

<section class="hero">
	<div class="container hero__inner">
		<div class="hero__content">
			<h1 class="hero__title">
				<span class="hero__line"><span class="hero__accent">Mantenimiento</span> &amp;</span>
				<span class="hero__line">reparación</span>
				<span class="hero__line">de equipos.<span class="cursor" aria-hidden="true">_</span></span>
			</h1>
			<p class="hero__lead">
				Limpiamos, reparamos y armamos computadores y consolas de videojuegos. Te explicamos qué tiene tu equipo
				y cuánto cuesta arreglarlo antes de tocarlo.
			</p>
			<div class="hero__actions">
				<Button href="#contacto" size="lg" icon="arrow-up-right">Solicitar servicio</Button>
				<Button href="#servicios" variant="ghost" size="lg" icon="arrow-down">Explorar servicios</Button>
			</div>
		</div>

		<div class="bench">
			<figure class="bench__figure">
				<Image
					class="bench__image"
					src={heroBench}
					alt="Retrato del técnico del laboratorio con traje oscuro sobre fondo rojo"
					loading="eager"
					fetchpriority="high"
				/>
				<span class="bench__tag label">Laboratorio // Atención directa</span>
				<figcaption class="bench__note">
					<span class="label">// Trato directo</span>
					<span class="bench__note-text">Hablas con quien repara tu equipo.</span>
				</figcaption>
			</figure>

			<div class="terminal" aria-hidden="true">
				<div class="terminal__bar">
					<span>registro_de_servicio.log</span>
					<span class="terminal__status">Listo</span>
				</div>
				<ol class="terminal__lines">
					{
						log.map((line, index) => (
							<li>
								<span class="terminal__index">{String(index + 1).padStart(2, '0')}</span>
								<span>&gt; {line}</span>
							</li>
						))
					}
				</ol>
			</div>
		</div>
	</div>
</section>

<style>
	.hero {
		position: relative;
		overflow: hidden;
		padding-block: clamp(2.5rem, 1rem + 5vw, 5rem) var(--space-section);
		background: radial-gradient(
			60rem 34rem at 78% 30%,
			color-mix(in srgb, var(--color-accent) 16%, transparent),
			transparent 70%
		);
	}

	.hero__inner {
		display: grid;
		grid-template-columns: minmax(0, 1.45fr) minmax(0, 1fr);
		align-items: center;
		gap: clamp(2rem, 1rem + 3vw, 3.5rem);
	}

	.hero__content {
		container-type: inline-size;
	}

	/* Sized against the column so the longest line never wraps. */
	.hero__title {
		font-size: clamp(2.25rem, 13.2cqi, 6.5rem);
		line-height: var(--leading-tight);
		letter-spacing: -0.01em;
	}

	.hero__line {
		display: block;
		white-space: nowrap;
	}

	.hero__accent {
		color: var(--color-accent);
	}

	.hero__lead {
		max-width: 36rem;
		margin-top: var(--space-5);
		color: var(--color-text-body);
		font-size: clamp(var(--text-base), 0.9rem + 0.5vw, var(--text-xl));
	}

	.hero__actions {
		display: flex;
		flex-wrap: wrap;
		gap: var(--space-4);
		margin-top: var(--space-6);
	}

	.bench {
		position: relative;
		display: grid;
		gap: var(--space-2);
		padding: var(--space-2);
		background: var(--color-surface);
		border: 1px solid var(--color-border-strong);
	}

	.bench::before,
	.bench::after {
		content: '';
		position: absolute;
		width: 0.375rem;
		height: 0.375rem;
		background: var(--color-accent);
	}

	.bench::before {
		top: -0.1875rem;
		left: -0.1875rem;
	}

	.bench::after {
		right: -0.1875rem;
		bottom: -0.1875rem;
	}

	.bench__figure {
		position: relative;
	}

	.bench__figure :global(.bench__image) {
		width: 100%;
		aspect-ratio: 1;
		object-fit: cover;
		object-position: center 18%;
	}

	.bench__tag {
		position: absolute;
		top: var(--space-3);
		left: var(--space-3);
		padding: var(--space-1) var(--space-3);
		background: color-mix(in srgb, var(--color-bg) 85%, transparent);
		border: var(--border);
	}

	.bench__note {
		position: absolute;
		right: var(--space-3);
		bottom: var(--space-3);
		display: grid;
		gap: var(--space-1);
		max-width: min(15rem, calc(100% - var(--space-5)));
		padding: var(--space-3) var(--space-4);
		background: color-mix(in srgb, var(--color-bg) 90%, transparent);
		border: 1px solid color-mix(in srgb, var(--color-accent) 55%, transparent);
	}

	.bench__note-text {
		color: var(--color-text-body);
		font-family: var(--font-mono);
		font-size: var(--text-xs);
		line-height: 1.5;
	}

	.terminal {
		padding: var(--space-3) var(--space-4);
		background: var(--color-bg);
		border: var(--border);
		font-family: var(--font-mono);
		font-size: var(--text-xs);
	}

	.terminal__bar {
		display: flex;
		justify-content: space-between;
		gap: var(--space-4);
		padding-bottom: var(--space-2);
		margin-bottom: var(--space-2);
		border-bottom: var(--border);
		color: var(--color-text-muted);
		letter-spacing: 0.06em;
		text-transform: uppercase;
	}

	.terminal__status {
		color: var(--color-accent);
	}

	.terminal__lines li {
		display: flex;
		gap: var(--space-3);
		color: var(--color-text-body);
		overflow-wrap: anywhere;
	}

	.terminal__index {
		flex-shrink: 0;
		color: var(--color-accent);
	}

	@media (max-width: 60rem) {
		.hero__inner {
			grid-template-columns: minmax(0, 1fr);
		}

		.bench {
			max-width: 36rem;
		}
	}

	@media (max-width: 30rem) {
		.bench__note {
			position: static;
			max-width: none;
			margin-top: var(--space-2);
		}

		.hero__actions :global(.button) {
			width: 100%;
		}
	}
</style>
